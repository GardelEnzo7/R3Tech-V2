# All variables below are optional — the site builds and runs correctly with none of them set.

# Google Analytics 4 measurement ID. When unset, GA4 is not loaded at all
# (no script, no request) — see components/analytics/google-analytics.tsx.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID. When unset, Clarity is not loaded at all
# (no script, no request) — see components/analytics/clarity.tsx.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
